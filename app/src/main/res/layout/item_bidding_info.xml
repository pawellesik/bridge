<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="4dp"
    android:paddingVertical="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/public_knowledge_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_public_knowledge"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_pk_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/public_knowledge_header"
            android:textColor="#4D7C4F"
            android:textStyle="bold"
            android:textSize="11sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@android:drawable/ic_dialog_info"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="#303F9F"
            android:contentDescription="Info" />

        <TextView
            android:id="@+id/tv_pk_north"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#1B2E1D"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@id/tv_pk_header" />

        <TextView
            android:id="@+id/tv_pk_south"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="#1B2E1D"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@id/tv_pk_north" />

        <TextView
            android:id="@+id/tv_pk_trump"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#4D7C4F"
            android:textStyle="bold"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@id/tv_pk_south" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bidding Hints Container (Below Public Knowledge, with dedicated scroll) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bidding_hints_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_bidding_hints"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/public_knowledge_container">

        <TextView
            android:id="@+id/tv_hints_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bidding_hints_header"
            android:textColor="#243D65"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="Hints"
            android:src="@drawable/ic_star"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#243D65" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxHeight="120dp"
            android:overScrollMode="never"
            app:layout_constrainedHeight="true"
            app:layout_constraintTop_toBottomOf="@id/tv_hints_header">

            <LinearLayout
                android:id="@+id/layout_hints_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
