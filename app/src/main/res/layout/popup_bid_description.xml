<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:gravity="start"
    android:orientation="vertical">

    <!-- Top Triangle Arrow pointing UP (Overlaps card's top stroke line) -->
    <ImageView
        android:id="@+id/iv_popup_arrow"
        android:layout_width="16dp"
        android:layout_height="12dp"
        android:layout_marginBottom="-2dp"
        android:contentDescription="@null"
        android:elevation="2dp"
        android:src="@drawable/ic_bubble_arrow"
        android:translationZ="2dp" />

    <!-- Main Card Body with Shape Background -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="260dp"
        android:background="@drawable/bg_popup_bubble"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Bid Header: "Uzasadnienie: 1 ♣" / "Explanation: 1 ♣" -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_popup_bid_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/explanation_label"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_popup_bid_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_popup_bid_suit"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="3dp"
                android:contentDescription="@null"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Description Body -->
        <TextView
            android:id="@+id/tv_popup_bid_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#222222"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
