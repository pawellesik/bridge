<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:minHeight="36dp"
    android:background="@drawable/sel_history_row">

    <TextView
        android:id="@+id/tv_row_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:textStyle="bold"
        android:padding="4dp" />

    <LinearLayout
        android:id="@+id/container_row_contract"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_weight="1.5"
        android:layout_gravity="center_vertical"
        android:layout_marginHorizontal="4dp"
        android:background="@drawable/bright_green_frame_black_sharp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_row_contract"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_row_suit"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_row_result_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_row_my1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:padding="4dp" />

    <TextView
        android:id="@+id/tv_row_opps1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:padding="4dp" />

    <TextView
        android:id="@+id/tv_row_my2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:padding="4dp" />

    <TextView
        android:id="@+id/tv_row_opps2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:padding="4dp" />

</LinearLayout>
