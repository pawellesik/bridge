<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp"
    android:background="@drawable/sel_history_row"
    android:orientation="horizontal"
    android:divider="@drawable/divider_white"
    android:showDividers="middle">

    <!-- Kolumna 1: Gracze (Players) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.0"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="2dp">
        <TextView
            android:id="@+id/tv_row_name_north"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_row_name_south"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Kolumna 2: Kontrakt -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5">
        <LinearLayout
            android:id="@+id/container_row_contract"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bright_green_frame_black_sharp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tv_row_contract"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/iv_row_suit"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="1dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tv_row_result_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Kolumna 3: My (Score) -->
    <TextView
        android:id="@+id/tv_row_my1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:padding="4dp" />

    <!-- Kolumna 4: Oni (Score) -->
    <TextView
        android:id="@+id/tv_row_opps1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:padding="4dp" />

    <!-- Kolumna 5: Imp -->
    <TextView
        android:id="@+id/tv_row_imp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:padding="4dp" />

</LinearLayout>
