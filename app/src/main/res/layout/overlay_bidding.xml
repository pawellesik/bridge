<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bidding_history_outer_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bidding_container"
    android:padding="1dp">

    <!-- Table Header with white dividers and localized names -->
    <LinearLayout
        android:id="@+id/bidding_header"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/bg_bidding_table_header"
        android:orientation="horizontal"
        android:weightSum="4"
        android:divider="@drawable/divider_white"
        android:dividerPadding="0dp"
        android:showDividers="middle"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/player_west"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/player_north"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/player_east"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/player_south"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- System Selection Layer -->
    <LinearLayout
        android:id="@+id/system_selection_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FDF9F3"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/bidding_header">

        <!-- Header with Gavel Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D1C4B9" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="6dp"
                android:src="@drawable/ic_history"
                app:tint="#1B2E1D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Bidding System"
                android:textColor="#1B2E1D"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D1C4B9" />
        </LinearLayout>

        <!-- Horizontal Scroll of Systems -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- WJ - Polish Club -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/system_wj"
                    android:layout_width="90dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_blue_button"
                    android:backgroundTint="#FFFFFF"
                    android:elevation="2dp"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_history"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#1B2E1D" />

                    <TextView
                        android:id="@+id/tv_wj_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WJ"
                        android:textColor="#2E7D32"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/divider_wj"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/divider_wj"
                        android:layout_width="30dp"
                        android:layout_height="1dp"
                        android:background="#D1C4B9"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Polish\nClub"
                        android:textColor="#1B2E1D"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/divider_wj" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- SAYC -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/system_sayc"
                    android:layout_width="90dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_blue_button"
                    android:backgroundTint="#FFFFFF"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/tv_sayc_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SAYC"
                        android:textColor="#673AB7"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/divider_sayc"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/divider_sayc"
                        android:layout_width="30dp"
                        android:layout_height="1dp"
                        android:background="#D1C4B9"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Standard\nAmerican"
                        android:textColor="#1B2E1D"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/divider_sayc" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- NatC -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/system_natc"
                    android:layout_width="90dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_blue_button"
                    android:backgroundTint="#FFFFFF"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/tv_natc_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NatC"
                        android:textColor="#1976D2"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/divider_natc"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/divider_natc"
                        android:layout_width="30dp"
                        android:layout_height="1dp"
                        android:background="#D1C4B9"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Natural\nClub"
                        android:textColor="#1B2E1D"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/divider_natc" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Locked: 2/1 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="90dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="8dp"
                    android:alpha="0.5"
                    android:background="@drawable/bg_blue_button"
                    android:backgroundTint="#E0E0E0"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@android:drawable/ic_lock_lock"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#9E9E9E" />

                    <TextView
                        android:id="@+id/tv_21_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2/1"
                        android:textColor="#9E9E9E"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/divider_21"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/divider_21"
                        android:layout_width="30dp"
                        android:layout_height="1dp"
                        android:background="#D1C4B9"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_21_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Two Over\nOne"
                        android:textColor="#9E9E9E"
                        android:textSize="10sp"
                        app:layout_constraintTop_toBottomOf="@id/divider_21" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_bidding_history_list"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:text="Soon"
                        android:textColor="#9E9E9E"
                        android:textSize="8sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Footer Note -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="#9E9E9E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="More systems will be available in future updates."
                android:textColor="#9E9E9E"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_bidding_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_bidding_history_list"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        android:clipToOutline="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/system_selection_container" />

</androidx.constraintlayout.widget.ConstraintLayout>