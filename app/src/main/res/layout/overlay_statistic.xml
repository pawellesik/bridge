<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/statistic_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_table_gradient"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- Header (Handles Window Insets in GameActivity) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/statistic_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_nav"
        android:elevation="50dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:translationZ="100dp"
        app:layout_constraintTop_toTopOf="parent">
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statistic_header_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- SESSION STATISTICS CARD (TOP POSITION, WITH CLEAR BUTTONS) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#16321A"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#4081C784"
                app:strokeWidth="1dp">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="12dp"
                    android:shrinkColumns="*"
                    android:stretchColumns="*">

                    <!-- Table Column Header Row -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:text="SESSION"
                            android:textColor="#81C784"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_arrow"
                                app:tint="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="Just Declare"
                                android:textColor="#80FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_person"
                                app:tint="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="Singleplayer"
                                android:textColor="#80FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_multi"
                                app:tint="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="Multiplayer"
                                android:textColor="#80FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </TableRow>

                    <View
                        android:layout_height="0.5dp"
                        android:background="#1AFFFFFF" />

                    <!-- Row: Games -->
                    <TableRow
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">

                        <LinearLayout android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_history"
                                app:tint="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Games"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="24"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="18"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="12"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </TableRow>

                    <View
                        android:layout_height="0.5dp"
                        android:background="#1AFFFFFF" />

                    <!-- Row: Deals -->
                    <TableRow
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">

                        <LinearLayout android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_cards"
                                app:tint="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Deals"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="212"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="180"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="140"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </TableRow>

                    <View
                        android:layout_height="0.5dp"
                        android:background="#1AFFFFFF" />

                    <!-- Row: Concedes -->
                    <TableRow
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">

                        <LinearLayout android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:rotation="180"
                                android:src="@drawable/ic_arrow"
                                app:tint="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Concedes"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="2"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </TableRow>

                    <View
                        android:layout_height="0.5dp"
                        android:background="#1AFFFFFF" />

                    <!-- Row: IMP -->
                    <TableRow
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">

                        <LinearLayout android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_trophy"
                                app:tint="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="IMP"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="+14"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="+8"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="+6"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </TableRow>

                    <View
                        android:layout_height="0.5dp"
                        android:background="#1AFFFFFF" />

                    <!-- Row: Max IMP -->
                    <TableRow
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">

                        <LinearLayout android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_star"
                                app:tint="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Max IMP"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="+12"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="+8"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="+10"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </TableRow>

                    <View
                        android:layout_height="0.5dp"
                        android:background="#1AFFFFFF" />

                    <!-- Row: Wins -->
                    <TableRow
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">

                        <LinearLayout android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_medal"
                                app:tint="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Wins"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="16 (67%)"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="11 (61%)"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="7 (58%)"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </TableRow>



                    <!-- Separator Line before Clear Buttons -->
                    <View
                        android:layout_height="0.5dp"
                        android:layout_marginTop="12dp"
                        android:background="#1AFFFFFF" />

                    <!-- Row: Clear Buttons -->
                    <TableRow
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical">

                        <View /> <!-- Label column space -->

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_clear_just_declare"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="1dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="2dp"
                            android:paddingVertical="0dp"
                            android:text="CLEAR"
                            android:textColor="#E57373"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/ic_delete"
                            app:iconGravity="textStart"
                            app:iconPadding="1dp"
                            app:iconSize="10dp"
                            app:iconTint="#E57373"
                            app:rippleColor="#33E57373"
                            app:strokeColor="#E57373"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_clear_singleplayer"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="1dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="2dp"
                            android:paddingVertical="0dp"
                            android:text="CLEAR"
                            android:textColor="#E57373"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/ic_delete"
                            app:iconGravity="textStart"
                            app:iconPadding="1dp"
                            app:iconSize="10dp"
                            app:iconTint="#E57373"
                            app:rippleColor="#33E57373"
                            app:strokeColor="#E57373"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_clear_multiplayer"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="1dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="2dp"
                            android:paddingVertical="0dp"
                            android:text="CLEAR"
                            android:textColor="#E57373"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/ic_delete"
                            app:iconGravity="textStart"
                            app:iconPadding="1dp"
                            app:iconSize="10dp"
                            app:iconTint="#E57373"
                            app:rippleColor="#33E57373"
                            app:strokeColor="#E57373"
                            app:strokeWidth="1dp" />
                    </TableRow>

                </TableLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- GLOBAL STATISTICS CARD (SECOND POSITION) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#16321A"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#4081C784"
                app:strokeWidth="1dp">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="12dp"
                    android:shrinkColumns="*"
                    android:stretchColumns="*">

                    <!-- Table Column Header Row -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:text="GLOBAL"
                            android:textColor="#81C784"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_arrow"
                                app:tint="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="Just Declare"
                                android:textColor="#80FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_person"
                                app:tint="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="Singleplayer"
                                android:textColor="#80FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_multi"
                                app:tint="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="Multiplayer"
                                android:textColor="#80FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </TableRow>

                    <View
                        android:layout_height="0.5dp"
                        android:background="#1AFFFFFF" />

                    <!-- Row: Games -->
                    <TableRow
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">

                        <LinearLayout android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_history"
                                app:tint="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Games"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="128"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="96"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="64"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </TableRow>

                    <View
                        android:layout_height="0.5dp"
                        android:background="#1AFFFFFF" />

                    <!-- Row: Deals -->
                    <TableRow
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">

                        <LinearLayout android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_cards"
                                app:tint="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Deals"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="1,248"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="1,032"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="712"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </TableRow>

                    <View
                        android:layout_height="0.5dp"
                        android:background="#1AFFFFFF" />

                    <!-- Row: Concedes -->
                    <TableRow
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">

                        <LinearLayout android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:rotation="180"
                                android:src="@drawable/ic_arrow"
                                app:tint="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Concedes"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="12"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="8"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="5"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </TableRow>

                    <View
                        android:layout_height="0.5dp"
                        android:background="#1AFFFFFF" />

                    <!-- Row: IMP -->
                    <TableRow
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">

                        <LinearLayout android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_trophy"
