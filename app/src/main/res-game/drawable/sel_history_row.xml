<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Wiersz wybrany (zaznaczony) -->
    <item android:state_activated="true">
        <shape>
            <solid android:color="#1B3E20" /> <!-- Ciemna zieleń dla aktywnego -->
        </shape>
    </item>
    <!-- Wiersz parzysty (subtelne odcięcie) -->
    <item android:state_selected="true">
        <shape>
            <solid android:color="#10000000" /> <!-- Bardzo delikatny cień -->
        </shape>
    </item>
    <!-- Domyślny wiersz -->
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
